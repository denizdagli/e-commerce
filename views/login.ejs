
<!doctype html>
<html lang="en">
	<%- include ('partials/_header') -%>

	<body>


		<div class="untree_co-section">
    <div class="container">
      <div class="row">
        <div class="col-md-12 text-center pt-5">
         
		  <div class="login-form">
			<h2 class="display-3 text-black">Giriş</h2>
			<form action="/login" method="post">
				<div class="container">
					<div class="row justify-content-center mt-3">
						<div class="col-3">
							<label for="username">Kullanıcı Adı:</label>
							<input type="text" id="username" name="username" required>
						</div>
					</div>
					<div class="row justify-content-center my-3">
						<div class="col-3">
							<label for="password">Şifre:</label>
							<input type="password" id="password" name="password" required>
						</div>
					</div>
				</div>		
                <a onclick="userAll()" class="btn btn-sm btn-outline-black">Giriş</a>
            </p>
        
			</form>
		</div>
          
          <p class="lead mb-5">Hesabınız yoksa <a href="/register">buradan</a> oluşturabilirsiniz.</p>
		  
         
        </div>
      </div>
    </div>
  </div>

  <%- include ('partials/_footer') -%>

		<script src="js/bootstrap.bundle.min.js"></script>
		<script src="js/tiny-slider.js"></script>
		<script src="js/custom.js"></script>
	</body>
    <script>
        async function userAll() {
            try {
                const usernameI = document.getElementById('username').value;
                const passwordI = document.getElementById('password').value;
    
                const response = await fetch('api/userAll', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                });
    
                const result = await response.json();
    
                if (result.success) {
                    console.log('Veri çekme başarılı:', result.data);
    
                    const foundUser = result.data.find(item => item.username === usernameI && item.password === passwordI);
                    
                    if (foundUser) {
                        console.log('Kullanıcı bulundu, sayfa yönlendiriliyor...');
                        localStorage.setItem('usernameI', usernameI);  //login olan kişinin username'ni localStorge kayıt eder.
                        window.location.href = '/index';
                    } else {
                        console.error('Kullanıcı adı veya parola hatalı');
                        
                        alert('Kullanıcı adı veya parola hatalı');
                    }
    
                } else {
                    console.error('Veri çekme başarısız:', result.message);
                }
            } catch (error) {
                console.error('Hata:', error);
            }
            return true;
        }
    </script>
    
</html>
