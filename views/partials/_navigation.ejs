<script>

    document.addEventListener('DOMContentLoaded', function () {
        userAll();
    });


    async function userAll() {
            try {
                const getUsername = localStorage.getItem('usernameI'); //Local Storge username bilgisini çeker

                console.log("Username:", getUsername);

                
                const response = await fetch('api/userAll', {
                    method: 'GET',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                });
    
                const result = await response.json();
    
                if (result.success) {
                    console.log('Veri çekme başarılı:', result.data);
    
                    const foundUser = result.data.find(item => item.username === getUsername);
                    
                    if (foundUser) {
                        console.log(foundUser.name);
                        console.log(foundUser.surname);
                        document.getElementById('nameLabel').textContent = foundUser.name;
                        document.getElementById('surnameLabel').textContent = foundUser.surname;
                    } else {
                        console.error('Kullanıcı adı veya parola hatalı');
                        
                        alert('Kullanıcı adı veya parola hatalı');
                    }
    
                } else {
                    console.error('Veri çekme başarısız:', result.message);
                }
            } catch (error) {
                console.error('Hata:', error);
            }
            return true;
        }
</script>


